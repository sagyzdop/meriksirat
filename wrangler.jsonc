/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meriksirat",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_modules"],
  "d1_databases": [
    {
      "binding": "meriksirat_d1",
      "database_name": "meriksirat",
      "database_id": "33d58061-8c68-4dda-a98c-2638a6975edc",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "meriksirat",
      "binding": "meriksirat_r2",
    },
  ],
  "main": "./server.ts",
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "meriksirat_kv",
      "id": "af581732fe484f5aa188c9814a1ea4dd",
    },
  ],
  /**
   * Rate Limiting Bindings
   * Replaces the KV-backed fixed-window rate limiter. These bindings use
   * Cloudflare's native Rate Limiting infrastructure — no KV reads/writes.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
   */
  "ratelimits": [
    {
      "name": "rl_telegram_webhook",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "rl_images",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "rl_public_albums",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "rl_album_detail",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "rl_refresh_album",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "rl_create_upload_session",
      "namespace_id": "1006",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "rl_create_booking",
      "namespace_id": "1007",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "rl_add_booking_items",
      "namespace_id": "1008",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  /**
   * Cron Triggers
   * Scheduled tasks that run at specified intervals
   * Runs every 5 minutes to check for bookings that need status updates
   * https://developers.cloudflare.com/workers/configuration/cron-triggers/
   */
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": {  "directory": "./public/",  "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
