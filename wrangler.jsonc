/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meriksirat",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_modules"],
  "d1_databases": [
    {
      "binding": "meriksirat_d1",
      "database_name": "meriksirat",
      "database_id": "33d58061-8c68-4dda-a98c-2638a6975edc",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "meriksirat",
      "binding": "meriksirat_r2",
    },
  ],
  "main": "./server.ts",
  "observability": {
    "enabled": true,
  },
  /**
   * Rate Limiting Bindings
   * Replaces the KV-backed fixed-window rate limiter. These bindings use
   * Cloudflare's native Rate Limiting infrastructure — no KV reads/writes.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
   */
  "ratelimits": [
    {
      "name": "rl_telegram_webhook",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "rl_images",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "rl_public_albums",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "rl_album_detail",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "rl_refresh_album",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "rl_create_upload_session",
      "namespace_id": "1006",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "rl_create_booking",
      "namespace_id": "1007",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "rl_add_booking_items",
      "namespace_id": "1008",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "rl_favorites",
      "namespace_id": "1009",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  /**
   * Cron Triggers
   * Three triggers, each with its own budget. server.ts picks the steps by
   * matching controller.cron to these strings character for character, so
   * keep them equal to CRON_SCHEDULES in src/lib/cron/schedule.ts.
   * Every 5 minutes: bookings. Hourly: flamekeepers and albums. Daily 03:00 UTC: graduation.
   * https://developers.cloudflare.com/workers/configuration/cron-triggers/
   */
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *", "0 3 * * *"],
  },
  /**
   * Version metadata
   * Gives the Worker its deployed version id, which marks the once-per-deploy
   * Telegram bot configuration.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/version-metadata/
   */
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  /**
   * Smart Placement
   * Runs the Worker in the data center closest to the origin (D1/R2), cutting
   * subrequest latency and the CPU spent waiting on them.
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  "placement": { "mode": "smart" },
  "vars": {
    "GOOGLE_MASTER_EMAIL": "nu_image@nu.edu.kz",
  },
  /**
   * Workers Previews
   * Previews never inherit production settings and get no Cron Triggers. These
   * resources are separate from production so a Preview can't touch real data.
   * Telegram secrets are left unset on purpose so a Preview can't message anyone.
   * https://developers.cloudflare.com/workers/previews/
   */
  "previews": {
    "vars": {
      "BETTER_AUTH_URL": "https://dev-meriksirat.sagyzdop-cloudflare.workers.dev",
      "DEV": "true",
      "GOOGLE_MASTER_EMAIL": "nu_image@nu.edu.kz",
    },
    "d1_databases": [
      {
        "binding": "meriksirat_d1",
        "database_name": "meriksirat-preview",
        "database_id": "f8c2bfb6-20ca-4c9f-8d61-f947beb783b7",
      },
    ],
    "r2_buckets": [
      {
        "binding": "meriksirat_r2",
        "bucket_name": "meriksirat-preview",
      },
    ],
    "ratelimits": [
        {
          "name": "rl_telegram_webhook",
          "namespace_id": "2001",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "rl_images",
          "namespace_id": "2002",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "rl_public_albums",
          "namespace_id": "2003",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "rl_album_detail",
          "namespace_id": "2004",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "rl_refresh_album",
          "namespace_id": "2005",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "rl_create_upload_session",
          "namespace_id": "2006",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "rl_create_booking",
          "namespace_id": "2007",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "rl_add_booking_items",
          "namespace_id": "2008",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "rl_favorites",
          "namespace_id": "2009",
          "simple": { "limit": 60, "period": 60 },
        },
    ],
  },
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": {  "directory": "./public/",  "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
