# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare (for local dev — production uses wrangler bindings)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Google OAuth (Calendar + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MASTER_ACCESS_TOKEN=
GOOGLE_MASTER_REFRESH_TOKEN=
GOOGLE_MASTER_EMAIL=nu_image@nu.edu.kz

# Buffer account is connected from Admin > Settings > Storage and stored encrypted in D1.
# Random string that encrypts the stored buffer token. Set it as a Worker secret.
BUFFER_ENCRYPTION_KEY=
# Optional fallback used only until an account is connected in the app (see README).
GOOGLE_BUFFER_EMAIL=nuimage.storage@gmail.com
GOOGLE_BUFFER_REFRESH_TOKEN=
GOOGLE_BUFFER_FULL_REFRESH_TOKEN=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
# Channel ID should start with -100 for supergroups/channels (e.g., -1001234567890)
TELEGRAM_CLUB_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_RETURN_ENABLED=true

# Development mode (auto-skips Telegram onboarding step in dev)
DEV=true
