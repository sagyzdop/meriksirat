{
  "name": "meriksirat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate-local && VITE_ENABLE_DEVTOOLS=true npm run build && wrangler dev --local --test-scheduled --port 3000",
    "dev:vite": "VITE_ENABLE_DEVTOOLS=true vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --name setup",
    "db:migrate-local": "wrangler d1 migrations apply meriksirat_d1 --local",
    "db:migrate-remote": "wrangler d1 migrations apply meriksirat_d1 --remote",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write ."
  },
